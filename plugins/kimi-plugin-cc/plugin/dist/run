#!/bin/sh
# kimi: starts one of this plugin's bundles on the installed plugin-core binary, downloading and verifying
#   it during setup.
#   sh "${CLAUDE_PLUGIN_ROOT}/dist/run" <bundle>.js [args...]
# plugin-core lives under ${AGENTS_CORE_HOME:-$HOME/.agents/core}/0.0.1; setup downloads it from
# MuhmdRaouf/claude-code-plugins's GitHub releases and verifies its sha256 there (CORE_DOWNLOAD_BASE overrides the release
# URL for tests). With no binary available and none downloadable this says why and exits 127; a hook (any
# --hook argument) never blocks or fails Claude Code: it exits 0 at once, starting one detached download —
# guarded by a lock in the version dir so every hook shares it — that installs the binary for the next hook.
# Generated by the plugin's scripts/build.mjs; do not edit.
dir=$(dirname -- "$0")
bundle=$1
shift
case "$bundle" in
  kimi.js) entry=cli ;;
  kimi-router.js) entry=router ;;
  kimi-passthrough.js) entry=passthrough ;;
  kimi-ensure.js) entry=ensure ;;
  *)
    echo "kimi: unknown bundle $bundle" >&2
    exit 2
    ;;
esac
hook=
detached=
for arg in "$@"; do
  [ "$arg" = "--hook" ] && hook=1
  [ "$arg" = "--detached-fetch" ] && detached=1
done
os=$(uname -s)
case "$os" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) os=unsupported ;;
esac
arch=$(uname -m)
case "$arch" in
  x86_64|amd64) arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) arch=unsupported ;;
esac
home=${AGENTS_CORE_HOME:-$HOME/.agents/core}
bin=$home/0.0.1/plugin-core
base=${CORE_DOWNLOAD_BASE:-https://github.com/MuhmdRaouf/claude-code-plugins/releases/download}
url=$base/v0.0.1/plugin-core-$os-$arch
want=
case "$os-$arch" in
  darwin-amd64) want=7814284125c5e3377cdfb92d4456b68cf96e1abe5d55acbc0b5e5f8e91cdcf9c ;;
  darwin-arm64) want=20812bcdd1b467de02be235672b95704933b49d936b39f3fb3d4edbda807828b ;;
  linux-amd64) want=575af4202dbe295e60b33c66dbc1b6bba33a7624d0309fe118eebad149f07889 ;;
  linux-arm64) want=012f9193c6446e8eb68c762ee26c8f203588bc77751ba5afa29789c60335366d ;;
esac

# download_core <timeout>: fetch the release asset, verify its sha256 and install it as $bin. Returns 0 when
# the binary is installed, 1 when the asset could not be fetched, 2 when it failed its checksum.
download_core() {
  timeout=$1
  mkdir -p "$home/0.0.1"
  tmp=$home/0.0.1/.plugin-core.$$.download
  got=
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --max-time "$timeout" -o "$tmp" "$url" && got=1
  elif command -v wget >/dev/null 2>&1; then
    wget -q -T "$timeout" -O "$tmp" "$url" && got=1
  fi
  if [ -z "$got" ]; then
    rm -f "$tmp"
    return 1
  fi
  sum=
  if command -v sha256sum >/dev/null 2>&1; then sum=$(sha256sum "$tmp")
  elif command -v shasum >/dev/null 2>&1; then sum=$(shasum -a 256 "$tmp")
  elif command -v openssl >/dev/null 2>&1; then sum=$(openssl dgst -sha256 -r "$tmp")
  fi
  if [ -n "$want" ] && [ "${sum%% *}" = "$want" ]; then
    chmod 755 "$tmp"
    mv -f "$tmp" "$bin"
    return 0
  fi
  rm -f "$tmp"
  return 2
}

# fetch_under_lock: the download a detached fetch runs. The version dir's lock holds the fetcher's pid and
# start time ("<pid> <epoch seconds>"); another fetch exits while that pid lives and the lock is under 120 s
# old, and takes over a lock whose holder died or stalled, so one download serves every hook.
fetch_under_lock() {
  trap '' HUP
  mkdir -p "$home/0.0.1"
  lock=$home/0.0.1/.plugin-core.fetch.lock
  now=$(date +%s)
  if (set -C; echo "$$ $now" >"$lock") 2>/dev/null; then
    :
  else
    read pid when <"$lock" || :
    if [ -z "$pid" ]; then
      sleep 1
      read pid when <"$lock" || :
    fi
    case "$pid" in *[!0-9]*|"") pid=0 ;; esac
    case "$when" in *[!0-9]*|"") when=0 ;; esac
    if [ "$pid" -ne 0 ] && kill -0 "$pid" 2>/dev/null && [ $(( $(date +%s) - when )) -lt 120 ]; then
      return 0
    fi
    rm -f "$lock"
    (set -C; echo "$$ $now" >"$lock") 2>/dev/null || return 0
  fi
  if [ -x "$bin" ]; then
    rm -f "$lock"
    return 0
  fi
  download_core 120
  rm -f "$lock"
  return 0
}

if [ "$os" != unsupported ] && [ "$arch" != unsupported ]; then
  if [ -x "$bin" ]; then
    exec "$bin" kimi "$entry" "$@"
  fi
  if [ "$entry" = cli ] && [ "$1" = setup ]; then
    timeout=120
    [ -n "$hook" ] && timeout=12
    download_core "$timeout"
    status=$?
    if [ "$status" = 0 ]; then
      exec "$bin" kimi "$entry" "$@"
    fi
    if [ -n "$hook" ]; then exit 0; fi
    if [ "$status" = 2 ]; then
      echo "kimi: plugin-core download failed its checksum" >&2
    else
      echo "kimi: could not download plugin-core 0.0.1 ($url)" >&2
    fi
    exit 127
  fi
  if [ -n "$detached" ]; then
    fetch_under_lock
    exit 0
  fi
  if [ -n "$hook" ]; then
    # One detached download for every hook: it re-runs this script on $0 with --detached-fetch, so the fetch
    # reuses the same URL and checksum table; it ignores HUP and outlives the hook that started it.
    (
      trap '' HUP
      sh_cmd=$(command -v sh 2>/dev/null) || sh_cmd=/bin/sh
      exec "$sh_cmd" "$0" "$bundle" --detached-fetch
    ) >/dev/null 2>&1 </dev/null &
  fi
fi
[ -n "$hook" ] && exit 0
[ -n "$detached" ] && exit 0
echo "kimi: plugin-core 0.0.1 is not installed; run /kimi:setup" >&2
exit 127
