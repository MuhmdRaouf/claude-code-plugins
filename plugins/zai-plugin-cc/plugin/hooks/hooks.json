{
  "description": "At session start, bring the zai router up and re-apply the setup (/model entries, agent models), then print a one-line summary when zai jobs await review; before each prompt and subagent, bring a router that died back; after a zai model agent finishes, tell the user what it ran on (glm-5.3 via the router, or Sonnet and why).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/dist/run\" zai.js setup --hook",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/dist/run\" zai.js board --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/dist/run\" zai-ensure.js --hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/dist/run\" zai-ensure.js --hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/dist/run\" zai.js usage --hook",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
