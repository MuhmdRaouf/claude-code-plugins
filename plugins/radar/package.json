{
  "name": "radar",
  "version": "0.0.1",
  "private": true,
  "description": "Claude Code plugin: live, token-free observability dashboard for sessions, agents, requests and tokens.",
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "todos": "node scripts/no-todos.mjs",
    "leg:bun": "bun scripts/runtime-leg.mjs",
    "leg:node": "node scripts/runtime-leg.mjs",
    "dist:fresh": "node scripts/build.mjs --check",
    "check": "npm run typecheck && npm run lint && npm run coverage && npm run todos && npm run dist:fresh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "daisyui": "5.7.47",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "preact": "11.0.1"
  }
}
