{
  "name": "@muhmdraouf/core",
  "version": "0.1.0",
  "private": true,
  "description": "The engine every delegation plugin shares: briefs, jobs, the drive loop, verification, rendering and the CLI.",
  "type": "module",
  "engines": {
    "node": ">=22.3",
    "bun": ">=1.3"
  },
  "exports": {
    "./testing": "./test/support/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "todos": "node scripts/no-todos.mjs",
    "test:bun": "TEST_RUNTIME=bun vitest run test/router/chaos.test.ts",
    "mutate": "stryker run",
    "check": "npm run typecheck && npm run lint && npm run coverage && npm run todos && npm run test:bun"
  },
  "dependencies": {
    "picomatch": "4.0.7",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.4",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "license": "GPL-3.0-or-later"
}
