{
  "name": "@muhmdraouf/ui",
  "version": "0.0.1",
  "description": "Preact components and helpers shared by the Huddle and Radar dashboards: charts, dialogs, menus, tabs, toasts, markdown, fuzzy match and time text.",
  "type": "module",
  "private": true,
  "exports": {
    "./*": "./src/*"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "bun run typecheck && bun run lint && bun run coverage"
  },
  "peerDependencies": {
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.7",
    "@vitest/coverage-v8": "5.0.3",
    "happy-dom": "20.14.5",
    "preact": "11.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuhmdRaouf/claude-code-plugins.git",
    "directory": "packages/ui"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  }
}
